    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.5"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,json}": [
