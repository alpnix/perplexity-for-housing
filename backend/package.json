    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-ws": "^5.0.2",
    "firebase-admin": "^13.0.1",
    "google-auth-library": "^9.15.0",
    "joi": "^17.13.3",
    "mongoose": "^8.9.1",
    "morgan": "^1.10.0",
