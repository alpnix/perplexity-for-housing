{
  "compilerOptions": {
    "target": "ES2022",
    "typeRoots": ["./src/@types", "./node_modules/@types"],
    "module": "CommonJS",
    "rootDir": "src",
    "moduleResolution": "Node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "jest.config.ts",
    "jest.config.js"
  ]
}
